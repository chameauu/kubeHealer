{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "K8sTarget": {
        "description": "The pod selector a Chaos Mesh experiment runs against.",
        "properties": {
          "label_selector": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Label Selector",
            "type": "object"
          },
          "mode": {
            "default": "one",
            "pattern": "^(one|all|fixed|fixed-percent|random-max-percent)$",
            "title": "Mode",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "namespace"
        ],
        "title": "K8sTarget",
        "type": "object"
      },
      "Scenario": {
        "description": "The record every list/get/stop call returns, whatever the backend.",
        "properties": {
          "backend_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backend Ref"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "domain": {
            "$ref": "#/components/schemas/ScenarioDomain"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "fault_type": {
            "title": "Fault Type",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "live_status": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Live Status"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/ScenarioStatus",
            "default": "pending"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/K8sTarget"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "title": "Target"
          }
        },
        "required": [
          "name",
          "domain",
          "fault_type"
        ],
        "title": "Scenario",
        "type": "object"
      },
      "ScenarioCreateRequest": {
        "description": "What a caller sends to launch either kind of scenario.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "domain": {
            "$ref": "#/components/schemas/ScenarioDomain"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "fault_type": {
            "title": "Fault Type",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "probability": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability",
            "type": "number"
          },
          "target": {
            "additionalProperties": true,
            "title": "Target",
            "type": "object"
          }
        },
        "required": [
          "name",
          "domain",
          "fault_type"
        ],
        "title": "ScenarioCreateRequest",
        "type": "object"
      },
      "ScenarioDomain": {
        "description": "Which backend actually runs the fault.",
        "enum": [
          "chaos_mesh",
          "simulator"
        ],
        "title": "ScenarioDomain",
        "type": "string"
      },
      "ScenarioList": {
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "title": "Scenarios",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "scenarios"
        ],
        "title": "ScenarioList",
        "type": "object"
      },
      "ScenarioStatus": {
        "description": "Lifecycle of a scenario.\n\n`completed` is deduced only when the backend object disappears; a\nscenario's duration never completes it on its own.",
        "enum": [
          "pending",
          "running",
          "stopping",
          "stopped",
          "completed",
          "failed"
        ],
        "title": "ScenarioStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "chaos",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/scenarios": {
      "get": {
        "operationId": "list_scenarios_scenarios_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ScenarioStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Scenarios",
        "tags": [
          "scenarios"
        ]
      },
      "post": {
        "operationId": "start_scenario_scenarios_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScenarioCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Scenario",
        "tags": [
          "scenarios"
        ]
      }
    },
    "/scenarios/{scenario_id}": {
      "delete": {
        "operationId": "remove_scenario_scenarios__scenario_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "scenario_id",
            "required": true,
            "schema": {
              "title": "Scenario Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove Scenario",
        "tags": [
          "scenarios"
        ]
      },
      "get": {
        "operationId": "get_scenario_scenarios__scenario_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "scenario_id",
            "required": true,
            "schema": {
              "title": "Scenario Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Scenario",
        "tags": [
          "scenarios"
        ]
      }
    },
    "/scenarios/{scenario_id}/stop": {
      "post": {
        "operationId": "stop_scenario_scenarios__scenario_id__stop_post",
        "parameters": [
          {
            "in": "path",
            "name": "scenario_id",
            "required": true,
            "schema": {
              "title": "Scenario Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stop Scenario",
        "tags": [
          "scenarios"
        ]
      }
    }
  }
}
