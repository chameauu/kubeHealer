{
  "components": {
    "schemas": {
      "CatalogResponse": {
        "description": "The catalogue listing envelope.",
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FaultCatalogEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total"
        ],
        "title": "CatalogResponse",
        "type": "object"
      },
      "CategoryTally": {
        "description": "Per-category counts for one component.",
        "properties": {
          "cascading": {
            "default": 0,
            "title": "Cascading",
            "type": "integer"
          },
          "network_partition": {
            "default": 0,
            "title": "Network Partition",
            "type": "integer"
          },
          "quota_limit": {
            "default": 0,
            "title": "Quota Limit",
            "type": "integer"
          },
          "resource_exhaustion": {
            "default": 0,
            "title": "Resource Exhaustion",
            "type": "integer"
          },
          "transient": {
            "default": 0,
            "title": "Transient",
            "type": "integer"
          }
        },
        "title": "CategoryTally",
        "type": "object"
      },
      "Classification": {
        "description": "The taxonomy verdict for one (domain, fault_type) pair.",
        "properties": {
          "domain": {
            "$ref": "#/components/schemas/ScenarioDomain"
          },
          "fault_type": {
            "title": "Fault Type",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "taxonomy_category": {
            "$ref": "#/components/schemas/TaxonomyCategory"
          }
        },
        "required": [
          "domain",
          "fault_type",
          "taxonomy_category",
          "rationale"
        ],
        "title": "Classification",
        "type": "object"
      },
      "ComponentRanking": {
        "description": "How often one component was the target of classified scenarios.",
        "properties": {
          "component": {
            "title": "Component",
            "type": "string"
          },
          "domain": {
            "$ref": "#/components/schemas/ScenarioDomain"
          },
          "tally": {
            "$ref": "#/components/schemas/CategoryTally"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "component",
          "domain",
          "tally",
          "total"
        ],
        "title": "ComponentRanking",
        "type": "object"
      },
      "FaultCatalogEntry": {
        "description": "One authored fault library entry.",
        "properties": {
          "authored": {
            "default": true,
            "title": "Authored",
            "type": "boolean"
          },
          "blast_radius_shape": {
            "title": "Blast Radius Shape",
            "type": "string"
          },
          "category_rationale": {
            "title": "Category Rationale",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "domain": {
            "$ref": "#/components/schemas/ScenarioDomain"
          },
          "fault_type": {
            "title": "Fault Type",
            "type": "string"
          },
          "mechanism": {
            "title": "Mechanism",
            "type": "string"
          },
          "taxonomy_category": {
            "$ref": "#/components/schemas/TaxonomyCategory"
          },
          "typical_symptoms": {
            "items": {
              "type": "string"
            },
            "title": "Typical Symptoms",
            "type": "array"
          }
        },
        "required": [
          "domain",
          "fault_type",
          "mechanism",
          "description",
          "blast_radius_shape",
          "typical_symptoms",
          "taxonomy_category",
          "category_rationale"
        ],
        "title": "FaultCatalogEntry",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RankingsResponse": {
        "description": "The full ranking payload, including what was filtered out and why.",
        "properties": {
          "generated_at": {
            "title": "Generated At",
            "type": "string"
          },
          "rankings": {
            "items": {
              "$ref": "#/components/schemas/ComponentRanking"
            },
            "title": "Rankings",
            "type": "array"
          },
          "scenarios_considered": {
            "title": "Scenarios Considered",
            "type": "integer"
          },
          "scenarios_excluded": {
            "title": "Scenarios Excluded",
            "type": "integer"
          }
        },
        "required": [
          "scenarios_considered",
          "scenarios_excluded",
          "generated_at"
        ],
        "title": "RankingsResponse",
        "type": "object"
      },
      "ScenarioDomain": {
        "description": "The backend a scenario is injected through.",
        "enum": [
          "chaos_mesh",
          "simulator"
        ],
        "title": "ScenarioDomain",
        "type": "string"
      },
      "TaxonomyCategory": {
        "description": "The five failure shapes the library recognises.",
        "enum": [
          "transient",
          "cascading",
          "resource-exhaustion",
          "network-partition",
          "quota-limit"
        ],
        "title": "TaxonomyCategory",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "faultlib",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/catalog": {
      "get": {
        "description": "Every catalogued entry, optionally restricted to one domain.",
        "operationId": "list_catalog_catalog_get",
        "parameters": [
          {
            "in": "query",
            "name": "domain",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ScenarioDomain"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Domain"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Catalog",
        "tags": [
          "library"
        ]
      }
    },
    "/catalog/{domain}/{fault_type}": {
      "get": {
        "description": "One catalogue entry; 404 when the pair is not catalogued.",
        "operationId": "get_entry_catalog__domain___fault_type__get",
        "parameters": [
          {
            "in": "path",
            "name": "domain",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ScenarioDomain"
            }
          },
          {
            "in": "path",
            "name": "fault_type",
            "required": true,
            "schema": {
              "title": "Fault Type",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaultCatalogEntry"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Entry",
        "tags": [
          "library"
        ]
      }
    },
    "/classify": {
      "post": {
        "description": "Classify a pair by lookup; 404 rather than a heuristic guess.",
        "operationId": "classify_fault_classify_post",
        "parameters": [
          {
            "in": "query",
            "name": "domain",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ScenarioDomain"
            }
          },
          {
            "in": "query",
            "name": "fault_type",
            "required": true,
            "schema": {
              "title": "Fault Type",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Classification"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Classify Fault",
        "tags": [
          "library"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/rankings": {
      "get": {
        "description": "Rank components from live chaos history; a dead engine is a 502.",
        "operationId": "rankings_rankings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Rankings",
        "tags": [
          "library"
        ]
      }
    }
  }
}
