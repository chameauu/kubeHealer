{
  "components": {
    "schemas": {
      "FaultType": {
        "enum": [
          "latency",
          "transient_error",
          "partial_failure",
          "quota_limit",
          "packet_loss",
          "pod_kill",
          "dependency_outage"
        ],
        "title": "FaultType",
        "type": "string"
      },
      "GenerateRequest": {
        "properties": {
          "count": {
            "default": 1,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "journey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "title": "GenerateRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JourneyStep": {
        "properties": {
          "latency_slo_ms": {
            "exclusiveMinimum": 0.0,
            "title": "Latency Slo Ms",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "operation": {
            "title": "Operation",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "name",
          "operation",
          "target",
          "latency_slo_ms"
        ],
        "title": "JourneyStep",
        "type": "object"
      },
      "LoadProfile": {
        "enum": [
          "steady",
          "spike",
          "burst",
          "soak",
          "concurrency_ramp"
        ],
        "title": "LoadProfile",
        "type": "string"
      },
      "RiskLevel": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "RiskLevel",
        "type": "string"
      },
      "RunRequest": {
        "properties": {
          "approved": {
            "default": false,
            "title": "Approved",
            "type": "boolean"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunResult": {
        "properties": {
          "aborted": {
            "title": "Aborted",
            "type": "boolean"
          },
          "approval_required": {
            "title": "Approval Required",
            "type": "boolean"
          },
          "availability": {
            "title": "Availability",
            "type": "number"
          },
          "error_budget_consumed": {
            "title": "Error Budget Consumed",
            "type": "number"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/StepEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "mttr_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mttr Ms"
          },
          "original_journey_verified": {
            "title": "Original Journey Verified",
            "type": "boolean"
          },
          "recovery_rate": {
            "title": "Recovery Rate",
            "type": "number"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "status": {
            "enum": [
              "completed",
              "aborted",
              "awaiting_approval"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "scenario",
          "status",
          "aborted",
          "approval_required",
          "availability",
          "recovery_rate",
          "mttr_ms",
          "error_budget_consumed",
          "original_journey_verified",
          "evidence",
          "explanation"
        ],
        "title": "RunResult",
        "type": "object"
      },
      "SafetyBudget": {
        "properties": {
          "abort_error_rate": {
            "default": 0.25,
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "title": "Abort Error Rate",
            "type": "number"
          },
          "abort_latency_ms": {
            "default": 5000,
            "minimum": 1.0,
            "title": "Abort Latency Ms",
            "type": "integer"
          },
          "max_concurrency": {
            "default": 25,
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Max Concurrency",
            "type": "integer"
          },
          "max_duration_seconds": {
            "default": 300,
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Max Duration Seconds",
            "type": "integer"
          }
        },
        "title": "SafetyBudget",
        "type": "object"
      },
      "Scenario": {
        "properties": {
          "concurrency": {
            "minimum": 1.0,
            "title": "Concurrency",
            "type": "integer"
          },
          "duration_seconds": {
            "minimum": 1.0,
            "title": "Duration Seconds",
            "type": "integer"
          },
          "fault_intensity": {
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "title": "Fault Intensity",
            "type": "number"
          },
          "fault_step": {
            "minimum": 0.0,
            "title": "Fault Step",
            "type": "integer"
          },
          "fault_type": {
            "$ref": "#/components/schemas/FaultType"
          },
          "journey": {
            "title": "Journey",
            "type": "string"
          },
          "load_profile": {
            "$ref": "#/components/schemas/LoadProfile"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "requires_approval": {
            "title": "Requires Approval",
            "type": "boolean"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "safety": {
            "$ref": "#/components/schemas/SafetyBudget"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/JourneyStep"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "seed",
          "name",
          "journey",
          "steps",
          "load_profile",
          "concurrency",
          "duration_seconds",
          "fault_type",
          "fault_step",
          "fault_intensity",
          "risk",
          "requires_approval",
          "safety"
        ],
        "title": "Scenario",
        "type": "object"
      },
      "StepEvidence": {
        "properties": {
          "baseline_latency_ms": {
            "title": "Baseline Latency Ms",
            "type": "integer"
          },
          "failed_requests": {
            "title": "Failed Requests",
            "type": "integer"
          },
          "fault_latency_ms": {
            "title": "Fault Latency Ms",
            "type": "integer"
          },
          "recovered_latency_ms": {
            "title": "Recovered Latency Ms",
            "type": "integer"
          },
          "requests": {
            "title": "Requests",
            "type": "integer"
          },
          "step": {
            "title": "Step",
            "type": "string"
          }
        },
        "required": [
          "step",
          "baseline_latency_ms",
          "fault_latency_ms",
          "recovered_latency_ms",
          "requests",
          "failed_requests"
        ],
        "title": "StepEvidence",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "journeys",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/scenarios/generate": {
      "post": {
        "operationId": "generate_scenarios_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Scenario"
                  },
                  "title": "Response Generate Scenarios Generate Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate",
        "tags": [
          "scenarios"
        ]
      }
    },
    "/scenarios/run": {
      "post": {
        "operationId": "run_scenarios_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run",
        "tags": [
          "scenarios"
        ]
      }
    }
  }
}
